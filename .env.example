# Copy this file to .env and fill in real values. .env is gitignored.
# OPENAI_API_KEY and CENSUS_KEY are read via Sys.getenv() by scripts in Code/
# (previously hardcoded inline — moved here as part of the 2026 Data/ reorg).
OPENAI_API_KEY=
CENSUS_KEY=

# Root folder containing Data/ and Outputs/ on THIS machine. Use forward
# slashes even on Windows (e.g. P:/BRAIN_DRAIN, not P:\BRAIN_DRAIN).
BRAIN_DRAIN_ROOT=

# Python install used by Code/01b_embed_new.R's reticulate/FAISS embedding
# step on THIS machine. Forward slashes, no quoting needed for paths with
# spaces (e.g. C:/Program Files/Python313/python.exe).
RETICULATE_PYTHON=
